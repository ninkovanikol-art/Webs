# ─── Anthropic / Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Amadeus (primary hotel inventory source) ─────────────────────────────────
# Register at: https://developers.amadeus.com
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
# Use 'test' for sandbox, 'production' for live data
AMADEUS_ENV=test

# ─── OpenWeatherMap ────────────────────────────────────────────────────────────
# Register at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key

# ─── Google Places API ─────────────────────────────────────────────────────────
# Enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ─── Eventbrite ────────────────────────────────────────────────────────────────
# Register at: https://www.eventbrite.com/platform/api
EVENTBRITE_API_KEY=your_eventbrite_api_key

# ─── Ticketmaster Discovery API ───────────────────────────────────────────────
# Register at: https://developer.ticketmaster.com
TICKETMASTER_API_KEY=your_ticketmaster_api_key

# ─── Upstash Redis (cache layer, 15-min TTL) ──────────────────────────────────
# Create a database at: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ─── App config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Maximum response time in ms before timeout
API_TIMEOUT_MS=8000
